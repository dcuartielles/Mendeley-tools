# Copy this file to `.env` and fill in your Mendeley API app credentials.
# Get them by registering an app at https://dev.mendeley.com/myapps.html
# with Redirect URL: http://localhost:8080/callback
#
# `.env` itself is git-ignored — never commit your real secret.
#
# PowerShell doesn't auto-load .env; load it before running the script, e.g.:
#   Get-Content .env | Where-Object { $_ -and $_ -notmatch '^\s*#' } |
#     ForEach-Object { $k,$v = $_ -split '=',2; Set-Item "env:$($k.Trim())" $v.Trim() }

MENDELEY_CLIENT_ID=your-client-id-here
MENDELEY_CLIENT_SECRET=your-client-secret-here
